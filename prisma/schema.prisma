// Schema do BxD-Stats.
//
// IMPORTANTE: o Prisma NAO e dono destas tabelas. Quem as cria e gerencia sao os
// plugins do servidor CS2 — o MatchZy (matchzy_stats_*) e o WeaponPaints
// (wp_player_*). Portanto:
//   - NUNCA rode `prisma migrate dev/deploy` nem `prisma db push` contra o banco.
//   - Para sincronizar mudancas de schema feitas pelos plugins, use `prisma db pull`
//     (introspeccao) e depois `prisma generate`.
//   - Este arquivo deve ESPELHAR exatamente o que os plugins criam.
//   - `prisma db pull` APAGA estes comentarios. Restaure-os depois de cada pull.
//
// Leitura x escrita (a regra muda por tabela):
//   - matchzy_stats_* (Match / Map / PlayerStats): SOMENTE LEITURA. O site so exibe.
//   - wp_player_* (skins): LEITURA E ESCRITA. Escolher skin e a funcao da pagina
//     /skins. Gravar dados: sim. Alterar o schema: nunca.
//
// Nota sobre os indices unicos das wp_player_*: eles existem (vieram do plugin),
// entao use `upsert` em vez de SELECT-depois-INSERT/UPDATE. O site PHP antigo
// fazia o caminho em duas etapas, que abre corrida entre duas abas abertas.

generator client {
  provider = "prisma-client-js"
}

// A URL e a do banco da LAN. O site passa a URL de cada servidor no
// construtor (getDb em src/lib/prisma.js). Os scripts de prisma/
// (sync, rebuild, db-admin) usam este default, ou seja, sempre a LAN.
datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL_LAN")
  relationMode = "prisma"
}

model Match {
  matchid     Int       @id @default(autoincrement())
  start_time  DateTime  @db.DateTime(0)
  end_time    DateTime? @db.DateTime(0)
  winner      String    @default("") @db.VarChar(255)
  series_type String    @default("") @db.VarChar(255)
  team1_name  String    @default("") @db.VarChar(255)
  team1_score Int       @default(0)
  team2_name  String    @default("") @db.VarChar(255)
  team2_score Int       @default(0)
  server_ip   String    @default("0") @db.VarChar(255)
  maps        Map[]

  @@map("matchzy_stats_matches")
}

model Map {
  matchid      Int
  mapnumber    Int           @db.UnsignedTinyInt
  start_time   DateTime      @db.DateTime(0)
  end_time     DateTime?     @db.DateTime(0)
  winner       String        @default("") @db.VarChar(16)
  mapname      String        @default("") @db.VarChar(64)
  team1_score  Int           @default(0)
  team2_score  Int           @default(0)
  match        Match         @relation(fields: [matchid], references: [matchid], onDelete: Cascade)
  player_stats PlayerStats[]

  @@id([matchid, mapnumber])
  @@index([mapnumber], map: "mapnumber_index")
  @@map("matchzy_stats_maps")
}

model PlayerStats {
  matchid                     Int
  mapnumber                   Int    @db.UnsignedTinyInt
  steamid64                   BigInt
  team                        String @default("") @db.VarChar(255)
  name                        String @db.VarChar(255)
  kills                       Int
  deaths                      Int
  damage                      Int
  assists                     Int
  enemy5ks                    Int
  enemy4ks                    Int
  enemy3ks                    Int
  enemy2ks                    Int
  utility_count               Int
  utility_damage              Int
  utility_successes           Int
  utility_enemies             Int
  flash_count                 Int
  flash_successes             Int
  health_points_removed_total Int
  health_points_dealt_total   Int
  shots_fired_total           Int
  shots_on_target_total       Int
  v1_count                    Int
  v1_wins                     Int
  v2_count                    Int
  v2_wins                     Int
  entry_count                 Int
  entry_wins                  Int
  equipment_value             Int
  money_saved                 Int
  kill_reward                 Int
  live_time                   Int
  head_shot_kills             Int
  cash_earned                 Int
  enemies_flashed             Int
  map                         Map    @relation(fields: [matchid, mapnumber], references: [matchid, mapnumber], onDelete: Cascade)

  @@id([matchid, mapnumber, steamid64])
  @@map("matchzy_stats_players")
}

model PlayerAgent {
  steamid  String  @unique(map: "steamid") @db.VarChar(18)
  agent_ct String? @db.VarChar(64)
  agent_t  String? @db.VarChar(64)

  @@map("wp_player_agents")
}

model PlayerGlove {
  steamid         String @db.VarChar(18)
  weapon_team     Int
  weapon_defindex Int

  @@unique([steamid, weapon_team], map: "steamid")

  @@map("wp_player_gloves")
}

model PlayerKnife {
  steamid     String @db.VarChar(18)
  weapon_team Int
  knife       String @db.VarChar(64)

  @@unique([steamid, weapon_team], map: "steamid")

  @@map("wp_player_knife")
}

model PlayerMusic {
  steamid     String @db.VarChar(64)
  weapon_team Int
  music_id    Int

  @@unique([steamid, weapon_team], map: "steamid")

  @@map("wp_player_music")
}

model PlayerPin {
  steamid     String @db.VarChar(64)
  weapon_team Int
  id          Int

  @@unique([steamid, weapon_team], map: "steamid")

  @@map("wp_player_pins")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model PlayerSkin {
  steamid               String  @db.VarChar(18)
  weapon_team           Int
  weapon_defindex       Int
  weapon_paint_id       Int
  weapon_wear           Float   @default(0.000001) @db.Float
  weapon_seed           Int     @default(0)
  weapon_nametag        String? @db.VarChar(128)
  weapon_stattrak       Boolean @default(false)
  weapon_stattrak_count Int     @default(0)
  weapon_sticker_0      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_1      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_2      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_3      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_4      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_keychain       String  @default("0;0;0;0;0") @db.VarChar(128)

  @@unique([steamid, weapon_team, weapon_defindex], map: "steamid")

  @@map("wp_player_skins")
}
